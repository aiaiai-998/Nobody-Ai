# ── Server side ONLY (api/chat.ts) ──────────────────────────────────────────
# These are read by the proxy function at runtime.
# NEVER prefix them with VITE_ — Vite inlines VITE_* values into the JavaScript
# it ships to browsers, which would make the key public.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ── Rate limits (optional; defaults shown) ──────────────────────────────────
# Per visitor, per minute / per day, plus a global daily ceiling that exists so
# a single scripted client cannot run up an unbounded bill.
RATE_LIMIT_RPM=20
RATE_LIMIT_PER_DAY=200
RATE_LIMIT_GLOBAL_PER_DAY=2000

# ── Shared rate limiting (optional but recommended for a public site) ───────
# Without these, the counters live in instance memory and reset on cold start.
# A free Upstash Redis database gives you the URL and token. Leave both blank
# to keep using the in-memory limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Build time, and NOT a secret ────────────────────────────────────────────
# Where the proxy lives. Setting this is what makes a deployment zero-setup:
# visitors never open Settings. It is a URL, not a credential.
VITE_PROXY_URL=/api/chat
